# 이 파일을 복사해서 이름을 .env 로 바꾸고 필요한 키만 채우세요. 비워 두면 그 기능만 꺼져요.

# 웹캠 영상을 화면 안에서 재생 (무료 키: https://api.windy.com/keys 에서 Webcams API 선택)
WINDY_API_KEY=

# Claude AI 상황 분석 (https://console.anthropic.com 에서 발급, 사용량만큼 과금)
ANTHROPIC_API_KEY=

# Claude 분석 버튼 비밀번호 (사이트로 올릴 때는 필수, PC에서는 선택)
ADMIN_PASSWORD=

# 포트를 바꾸고 싶을 때
PORT=3117
